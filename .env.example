# TypeSafe (Jev) API key. Get one from https://console.typesafe.ai (early access).
# The server also reads TYPESAFE_API_KEY from the repository root .env, so you
# usually do not need this file.
TYPESAFE_API_KEY=

# Optional overrides.
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_TIMEOUT_MS=4000
# PORT=4321
# HOST=127.0.0.1
